# Copy this file to .env.local and fill in the values. Never commit .env.local.
# In production, set the same variables in the host's settings (e.g. Vercel → Settings → Environment Variables).
# Server-only: never add a NEXT_PUBLIC_ prefix, or Next.js would send them to the browser.
# Same names and values as the TORCH site (crm-lp), so both book on the same calendar.

# Private Integration token of the CRM sub-account.
# Scopes needed: contacts.readonly, contacts.write, calendars.readonly, calendars/events.write.
GHL_PRIVATE_TOKEN=

# CRM sub-account (location) ID.
GHL_LOCATION_ID=

# The calendar the booking section reads free slots from and books 30-minute calls on.
GHL_CALENDAR_ID=
